
# Database Configuration
DB_HOST=localhost
DB_NAME=marketplace_db
DB_USER=root
DB_PASS=

# Website Configuration
SITE_URL=http://localhost:8080/marketplace
SITE_NAME=MarketPlace
ADMIN_EMAIL=admin@marketplace.com

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@marketplace.com

# Flutterwave Configuration
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_ENVIRONMENT=test
FLUTTERWAVE_SECRET_HASH=

# Paystack Configuration
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_ENVIRONMENT=test

# Payment Method Settings
ENABLE_PAY_ON_DELIVERY=true
ENABLE_FLUTTERWAVE=true
ENABLE_PAYSTACK=true

# Platform Fees (Naira)
PLATFORM_FEE_PERCENTAGE=10
AUCTION_LISTING_FEE=500.00
RESERVE_PRICE_FEE=1000.00

# Security
SALT=replace-with-a-unique-random-secret
SESSION_TIMEOUT=1800
